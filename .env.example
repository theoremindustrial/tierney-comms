# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail connector (Google Cloud Console -> APIs & Services -> Credentials;
# create an OAuth 2.0 Client ID of type "Web application" with
# GOOGLE_OAUTH_REDIRECT_URI added as an authorized redirect URI, and enable
# the Gmail API on the project)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/ingest/gmail/oauth/callback

# Shared secret for triggering /api/ingest/[provider] syncs (manual `?secret=`
# query param, or the `Authorization: Bearer` header Vercel Cron sends
# automatically when this env var is named CRON_SECRET — see vercel.json)
CRON_SECRET=generate-a-random-string

# Per-connector credentials (Slack/Twilio, etc.) are added here as each
# ingestion connector is built — see BUILD_PLAN.md.
